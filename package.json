{
  "name": "finverse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "ci:check": "npm run lint && npm run typecheck && npm run build",
    "gen:api": "openapi --input https://campaign-center-api-dev.up.railway.app/campaign-center-api/v1/swagger/doc.json --output src/lib/api --client fetch",
    "snyk:test": "snyk test --severity-threshold=high",
    "snyk:report": "snyk test --severity-threshold=high --json-file-output=snyk-report.json --sarif-file-output=snyk-report.sarif"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "openapi-typescript-codegen": "^0.30.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "nanoid": "5.1.16",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
